        "metadata_fields": {
          "symbol": "s",
          "event_time": "E",
          "agg_trade_id": "a",
          "first_trade_id": "f",
          "last_trade_id": "l"
        },
        "static_metadata": {
          "exchange": "binance",
          "symbol": "AAVEUSDT"
        },
        "rate_limit": {
          "capacity": 80,
          "refill_rate": 30
        }
      },
      "caller_params": {
        "reconnect": {
          "share_by_endpoint": true
        }
      },
      "pipeline_mode": "queue",
      "backfill_result_driven_enabled": true,
      "queue": {
        "mode": "bounded",
        "size": 20000
      },
      "handlers": [
        {
          "type": "binance_aggtrade",
          "with": {
            "symbol": "AAVEUSDT",
            "exchange": "binance"
          }
        },
        {
          "type": "integrity",
          "with": {
            "sequence_field": "agg_trade_id",
            "stream_key_field": "symbol",
            "eager_gap": 3,
            "max_gap": 20,
            "max_delay_ms": 500,
            "hard_timeout_ms": 20000,
            "backfill_cooldown_ms": 15000,
            "backfill": {
              "http": {
                "enabled": true,
                "transport": "rest",
                "endpoint": "https://fapi.binance.com/fapi/v1/aggTrades",
                "method": "GET",
                "range_window": true,
                "range_start_param": "fromId",
                "range_limit_param": "limit",
                "range_max_limit": 1000,
                "query": {
                  "symbol": "AAVEUSDT",
                  "limit": "1000"
                }
              }
            }
          }
        }
      ],
      "sink": {
        "type": "kafka",
        "with": {
          "topic": "perp.aggtrades",
          "key_from": [
            "symbol",
            "exchange"
          ]
        }
      }
    },
