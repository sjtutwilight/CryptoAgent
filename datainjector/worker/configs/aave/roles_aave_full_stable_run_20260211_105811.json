                "query": {
                  "symbol": "AAVEUSDT",
                  "limit": "500"
                }
              }
            }
          }
        },
        {
          "type": "orderbook_diff",
          "with": {
            "symbol": "AAVEUSDT",
            "exchange": "binance",
            "max_depth": 200
          }
        },
        {
          "type": "orderbook_validator",
          "with": {}
        }
      ],
      "sink": {
        "type": "file",
        "with": {
          "output_dir": "/tmp/aave_mock_recording_20260211_105811/binance/futures/orderbook/aaveusdt",
          "output_format": "jsonl",
          "filename_prefix": "orderbook",
          "max_records_per_file": 20000
        }
