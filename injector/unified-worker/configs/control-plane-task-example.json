      "task_specific_config": {
        "subscription": {
          "topics": ["btcusdt@trade"]
        }
      },
      "sequence_field": "T",
      "output_topic": "exchange.binance.trades",
      "report_to_control_plane": false,
      "retry_config": {
        "max_retries": 5,
        "backoff_base": 1,
        "backoff_max": 60
      }
    }
  ]
