# ===== 基础设施通用配置 =====
INFRA_ENV_NAME=local
INFRA_NETWORK=crypto-network

# ===== PostgreSQL / 数据库 =====
POSTGRES_CONTAINER_NAME=crypto-postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=twilight
POSTGRES_PASSWORD=twilight123
POSTGRES_DB=twilight
# ===== 历史兼容的 DB_* 变量 =====
DB_HOST=postgres
DB_PORT=5432
DB_USER=twilight
DB_PASSWORD=twilight123
DB_NAME=twilight
DB_SSLMODE=disable
PORT=8085

# ===== Kafka / ZooKeeper =====
ZOOKEEPER_CONTAINER_NAME=crypto-zookeeper
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

KAFKA_CONTAINER_NAME=crypto-kafka
KAFKA_BROKER_ID=1
KAFKA_INTERNAL_PORT=29092
KAFKA_EXTERNAL_PORT=9092
KAFKA_JMX_PORT=9101
INFRA_KAFKA_ADVERTISED_HOST=localhost
KAFKA_CLUSTER_NAME=crypto-cluster
KAFKA_BOOTSTRAP_SERVERS_LOCAL=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

KAFKA_UI_PORT=8080
KAFKA_EXPORTER_PORT=9308

# ===== Redis =====
REDIS_CONTAINER_NAME=crypto-redis
REDIS_PORT=6379
REDISINSIGHT_CONTAINER_NAME=crypto-redisinsight
REDISINSIGHT_PORT=5540

# ===== Flink =====
FLINK_IMAGE=flink:1.20-scala_2.12-java17
FLINK_JOBMANAGER_CONTAINER=flink-jobmanager
FLINK_TASKMANAGER_CONTAINER=flink-taskmanager
FLINK_JOBMANAGER_PORT=8081
FLINK_JOBMANAGER_PROM_PORT=9249
FLINK_TASKMANAGER_PROM_PORT=9250
FLINK_TASKMANAGER_PROM_PORT_RANGE=9250-9260
FLINK_AWS_ACCESS_KEY=admin
FLINK_AWS_SECRET=password123

# ===== ClickHouse =====
CLICKHOUSE_CONTAINER_NAME=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_PROM_PORT=9363
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# ===== 应用配置 =====
WORKER_CONFIG_PATH=/app/configs/base.yaml
CONTROL_PLANE_PROFILE=local

# ===== 其他可观测性组件 =====
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000

# ===== Redis Commander / 其他服务端口 =====
REDIS_COMMANDER_PORT=5540

# ===== 资源配置 (CPU in cores, memory in Docker-compatible units) =====
ZOOKEEPER_CPUS=0.25
ZOOKEEPER_MEM=256m
KAFKA_CPUS=1
KAFKA_MEM=1g
KAFKA_UI_CPUS=0.25
KAFKA_UI_MEM=256m
REDIS_CPUS=0.25
REDIS_MEM=256m
REDISINSIGHT_CPUS=0.25
REDISINSIGHT_MEM=256m
POSTGRES_CPUS=0.5
POSTGRES_MEM=512m
INIT_DB_CPUS=0.25
INIT_DB_MEM=256m
FLINK_JOBMANAGER_CPUS=1
FLINK_JOBMANAGER_MEM=1.6g
FLINK_TASKMANAGER_CPUS=1
FLINK_TASKMANAGER_MEM=1.8g
CLICKHOUSE_CPUS=1
CLICKHOUSE_MEM=1.5g
PROMETHEUS_CPUS=0.5
PROMETHEUS_MEM=512m
LOKI_CPUS=0.5
LOKI_MEM=512m
GRAFANA_CPUS=0.25
GRAFANA_MEM=256m
PROMTAIL_CPUS=0.25
PROMTAIL_MEM=256m
KAFKA_EXPORTER_CPUS=0.25
KAFKA_EXPORTER_MEM=128m
WORKER_APP_CPUS=0.5
WORKER_APP_MEM=512m
CONTROL_PLANE_CPUS=0.5
CONTROL_PLANE_MEM=512m
