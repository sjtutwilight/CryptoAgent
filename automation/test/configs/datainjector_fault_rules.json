{
  "role_ids": [],
  "fault_mode": "mock",
  "fault_case": "disconnect_reconnect",
  "fault_action": "role_restart",
  "fault_pause_seconds": 8,
  "observe_seconds": 20,
  "expect_backfill": false,
  "fault_rules": {
    "required_events": [
      "ws.reconnect.start",
      "ws.reconnect.success",
      "caller.response",
      "pipeline.finish"
    ],
    "required_backfill_events": [
      "integrity.backfill.trigger",
      "integrity.backfill.success"
    ],
    "fail_events": [
      "handler.error",
      "sink.error",
      "pipeline.error",
      "caller.error",
      "integrity.backfill.exhausted",
      "integrity.backfill.enqueue.error"
    ]
  }
}
